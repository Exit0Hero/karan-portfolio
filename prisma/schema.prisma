generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  tagline       String
  description   String
  category      ProjectCategory
  stack         String[]
  githubUrl     String?
  liveUrl       String?
  imageUrl      String?
  featured      Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  caseStudy     CaseStudy?
  analytics     AnalyticsEvent[]
}

model CaseStudy {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  problemStatement String
  hypothesis      String
  observations    String
  constraints     String[]
  architecture    Json?
  experiments     Json?
  decisions       Json?
  failures        String?
  results         String
  lessons         String[]
  nextSteps       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(cuid())
  title       String
  issuer      String
  date        DateTime
  imageUrl    String?
  verifyUrl   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  organization String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String
  tags        String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  field       String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  path      String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())
}

enum ProjectCategory {
  AI_OPTIMIZATION
  SYSTEMS
  DATA_ML
  WEB_PLATFORMS
}
